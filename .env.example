# ==============================================================================
# YOUR TUTOR — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and configure your keys if using online Gemini access.
# If no key is set, the application automatically runs in offline deterministic mode.

# Google Gemini API Key (Optional: needed only for live GeminiProvider)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Model Identifier (Optional)
GEMINI_MODEL=gemini-2.5-flash

# SQLite Database Path (Optional: defaults to data/your_tutor.db)
DATABASE_PATH=data/your_tutor.db
